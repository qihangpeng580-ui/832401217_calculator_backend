# Python runtime artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# Database files (generated at runtime, not committed)
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Virtual environments
venv/
.venv/
env/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# Editor and system temporary files
.vscode/
.idea/
*.swp
Thumbs.db
Desktop.ini

# Logs
*.log
